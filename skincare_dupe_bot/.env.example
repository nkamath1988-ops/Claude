# Copy to .env (or export these directly) before running the scheduler/web app for real.
# Never commit a real .env -- it's already in .gitignore.

# --- Email alerts (Gmail example: use an App Password, not your real password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_account@gmail.com
SMTP_PASSWORD=your_16_char_app_password
ALERT_RECIPIENT=your_account@gmail.com
PRICE_DROP_ALERT_THRESHOLD_PCT=20

# --- Scheduler cron expressions (5-field cron) ---
PRICE_CHECK_CRON=0 9 * * *
VIDEO_GEN_CRON=0 10 * * *
VIDEOS_PER_RUN=1

# --- Web dashboard ---
WEB_HOST=127.0.0.1
WEB_PORT=5000
